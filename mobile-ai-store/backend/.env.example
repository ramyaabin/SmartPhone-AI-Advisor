# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# OpenAI (used ONLY for embeddings + final answer generation)
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Retrieval backend: "chroma" (OpenAI embeddings) or "faiss" (HF Instructor embeddings, fully local)
RETRIEVAL_BACKEND=chroma

# ChromaDB (only needed if RETRIEVAL_BACKEND=chroma and you run a Chroma server instead of embedded mode)
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=mobile_products

# HuggingFace (only needed if RETRIEVAL_BACKEND=faiss)
HF_INSTRUCTOR_MODEL=hkunlp/instructor-base

# RAG tuning
TOP_K=4
CHUNK_SIZE=350
CHUNK_OVERLAP=40
