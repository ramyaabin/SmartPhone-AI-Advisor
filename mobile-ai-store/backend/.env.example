# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# OpenAI (used ONLY for embeddings + final answer generation)
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Retrieval backends to allow, comma-separated; the first is the default.
# "chroma" (OpenAI embeddings, needs a Chroma server) and/or "faiss" (local embeddings).
# The live demo uses "faiss" only.
RETRIEVAL_BACKENDS=chroma,faiss

# ChromaDB (only needed if RETRIEVAL_BACKENDS includes chroma)
CHROMA_URL=http://localhost:8000
CHROMA_COLLECTION=mobile_products

# HuggingFace (only needed if RETRIEVAL_BACKENDS includes faiss)
HF_INSTRUCTOR_MODEL=hkunlp/instructor-base

# RAG tuning
TOP_K=10
CHUNK_SIZE=350
CHUNK_OVERLAP=40
